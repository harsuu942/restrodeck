[Unit]
Description=WhatsLead Cloud POS Enterprise Service
After=network.target

[Service]
Type=simple
User=posuser
WorkingDirectory=/var/www/whatslead-pos
ExecStart=/usr/bin/python3 /var/www/whatslead-pos/server.py
Restart=always
RestartSec=3
KillMode=process

# Resource limits & Optimization
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
